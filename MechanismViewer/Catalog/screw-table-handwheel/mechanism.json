{
  "id": "screw-table-handwheel",
  "name": "Винтовой подъёмный столик с маховиком",
  "category": "Винтовые передачи",
  "description": "Маховик Ø60 вращает вертикальный винт Tr10×2; гайка поднимает столик 84×64 мм по двум направляющим на 40 мм за 20 оборотов. Самотормозящая передача: столик держит груз без фиксатора. По часовой стрелке (сверху) — вверх.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 40, "maxForceN": 60 },
  "envelopeMm": [100, 112, 80],

  // 20 оборотов по 2 мм; вращение по часовой (−θ вокруг +Y) поднимает столик. Рука — до 0,6 Н·м (≈ 25 Н на ручке).
  "driver": { "type": "crank", "part": "screw", "range": [-7200, 0], "handForce": 0.6 },
  "output": "table",

  "parts": [
    {
      "id": "screw",
      "name": "Винт Tr10×2 с маховиком",
      // Строится вдоль своей Z и поворачивается осью вверх (shapeAxis y): правая резьба, сверху — маховик с ручкой.
      "shape": [
        { "cylinder": { "r": 3.5, "z": [0, 86] } },
        { "thread": { "r": [3.5, 5], "pitch": 2, "z": [8, 78], "width": [1.2, 0.6] } },
        { "cylinder": { "r": 7, "z": [84, 92] } },
        { "cylinder": { "r": 30, "z": [86, 90], "segments": 64 } },
        { "cylinder": { "at": [24, 0], "r": 4, "z": [90, 104], "segments": 24 } }
      ],
      "shapeAxis": "y",
      "color": "#B8BEC6",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 1, 0] },
      // Маховик Ø60×4 PLA + стальной винт.
      "inertiaKgM2": 8e-6,
      "coulombFriction": 5e-4
    },
    {
      "id": "table",
      "name": "Столик с гайкой",
      // Гайка вокруг винта, над ней плита; втулки скользят по направляющим x = ±30.
      "shape": [
        { "box": [-9, -9, -6, 9, 9, 6] },
        { "box": [-42, -32, 6, 42, 32, 10] },
        { "cylinder": { "at": [30, 0], "r": 6, "z": [-6, 10] } },
        { "cylinder": { "at": [-30, 0], "r": 6, "z": [-6, 10] } }
      ],
      "shapeAxis": "y",
      "color": "#FFA500",
      // Нижнее положение: гайка на высоте 20 мм, плита — 26…30 мм.
      "joint": { "type": "prismatic", "origin": [0, 20, 0], "axis": [0, 1, 0] },
      "massKg": 0.03
    },
    {
      "id": "frame",
      "name": "Основание с направляющими",
      // Плита, подпятник винта, две направляющие и верхняя траверса (столик до неё не доходит: верх плиты ≤ 70).
      "shape": [
        { "box": [-50, -40, -8, 50, 40, 0] },
        { "cylinder": { "r": 7, "z": [0, 5] } },
        { "cylinder": { "at": [30, 0], "r": 3, "z": [0, 80] } },
        { "cylinder": { "at": [-30, 0], "r": 3, "z": [0, 80] } },
        { "box": [-36, -6, 76, 36, 6, 81] }
      ],
      "shapeAxis": "y",
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "screw", "from": "screw", "to": "table", "leadMm": -2 }
  ],

  "fasteners": [
    { "kind": "Упорный подшипник винта", "size": "51100", "attachedTo": "frame", "note": "в модели — подпятник основания" },
    { "kind": "Втулка скольжения направляющей", "size": "Ø6/Ø12×16", "count": 2, "attachedTo": "table", "note": "в модели — часть столика" },
    {
      "kind": "Винт крепления основания",
      "size": "M4×10",
      "type": "socket-screw",
      "diameterMm": 4,
      "lengthMm": 10,
      // В углах плиты, вне хода столика (x ±42, z ±32 — столик выше, головки ниже плиты столика).
      "positions": [[45, 0, 35], [-45, 0, 35], [45, 0, -35], [-45, 0, -35]],
      "axis": [0, -1, 0],
      "attachedTo": "frame"
    }
  ]
}
