{
  "id": "rack-jack-crank",
  "name": "Реечный домкрат с рукояткой",
  "category": "Зубчатые передачи",
  "description": "Рукоятка 40 мм на шестерне m1,5 z12 поднимает вертикальную рейку с опорной площадкой. Пять шестых оборота рукоятки (300°) дают подъём на 47 мм; рейка идёт в направляющей с прижимными планками.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 47, "angleDeg": 300, "maxForceN": 50 },
  "envelopeMm": [90, 144, 34],

  // Ручка: тянуть за шарик рукоятки по кругу. Упоры 0…300°, рука — до 1,5 Н·м (≈ 37 Н на шарике).
  "driver": { "type": "crank", "part": "crank", "range": [0, 300], "handForce": 1.5 },
  "output": "rack",

  "parts": [
    {
      "id": "crank",
      "name": "Шестерня с рукояткой",
      // Шестерня m1,5 z12 (r = 9) в слое z 0…8; впадина на 0° — к зубу рейки (зубья на 15° + 30°·k).
      // Рукоятка над рейкой и направляющими (z 12…16), шарик на радиусе 40.
      "shape": [
        { "gear": { "module": 1.5, "teeth": 12, "phaseDeg": 15, "z": [0, 8] } },
        { "cylinder": { "r": 5, "z": [-1, 8] } },
        { "cylinder": { "r": 6, "z": [8, 12.5] } },
        { "box": [0, -4, 12, 45, 4, 16] },
        { "cylinder": { "r": 6, "z": [12, 16] } },
        { "cylinder": { "at": [40, 0], "r": 5, "z": [16, 30], "segments": 32 } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      "gear": { "teeth": 12, "pitchRadiusMm": 9, "rootRadiusMm": 7.125, "thicknessMm": 8 },
      // Шестерня + рукоятка с шариком, PLA.
      "inertiaKgM2": 1.2e-5
    },
    {
      "id": "rack",
      "name": "Рейка с площадкой",
      // Начало координат — на делительной прямой напротив оси; зубья смотрят на шестерню (−X).
      // Прямая отодвинута на 0,2 мм от делительной окружности (r = 9): у z12 прямой профиль у ножки иначе задевает вершину зуба рейки.
      // Поворот рукоятки на +θ поднимает рейку на 9·θ мм; зубья покрывают весь ход (k −11…2).
      "shape": [
        { "box": [1.875, -55, 0, 9, 25, 8] },
        { "rack": { "origin": [0, 0], "direction": [0, 1], "module": 1.5, "teeth": [-11, 2], "z": [0, 8] } },
        { "box": [-14, 25, 0, 9, 29, 8] }
      ],
      "color": "#FFA500",
      "joint": { "type": "prismatic", "origin": [9.2, 0, 0], "axis": [0, 1, 0] },
      "massKg": 0.012
    },
    {
      "id": "frame",
      "name": "Основание с направляющей",
      // Задняя стенка-полоса под шестерней и рейкой; справа от рейки — две опоры с прижимными планками спереди (z 8,5…10), ниже рукоятки.
      "shape": [
        { "box": [-16, -62, -4, 26, 82, -2] },
        { "box": [18.5, 14, -2, 22, 34, 10] },
        { "box": [18.5, -34, -2, 22, -14, 10] },
        { "box": [12, 14, 8.5, 18.5, 34, 10] },
        { "box": [12, -34, 8.5, 18.5, -14, 10] },
        { "cylinder": { "r": 2.5, "z": [-2, 12] } }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "rack", "from": "crank", "to": "rack" }
  ],

  // Ось шестерни с рукояткой — часть стенки.
  "designedContacts": [["crank", "frame"]],

  "fasteners": [
    { "kind": "Ось шестерни", "size": "Ø5×14", "type": "pin", "attachedTo": "frame", "note": "в модели — часть основания" },
    {
      "kind": "Винт крепления опор направляющей",
      "size": "M3×10",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 10,
      // С обратной стороны стенки — головки не мешают рукоятке.
      "positions": [[20.25, 24, -4], [20.25, -24, -4]],
      "axis": [0, 0, 1],
      "attachedTo": "frame"
    }
  ]
}
