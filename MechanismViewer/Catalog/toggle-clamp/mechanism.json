{
  "id": "toggle-clamp",
  "name": "Рычажный зажим с коленом",
  "category": "Зажимы и фиксаторы",
  "description": "Рукоятка через тягу выдвигает плунжер на 31 мм к упору. У мёртвой точки (рукоятка почти вдоль плунжера) выигрыш в силе растёт многократно, и зажим держит деталь сам.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 31, "angleDeg": 107, "maxForceN": 200 },
  "envelopeMm": [152, 94, 18],

  // Рукоятка ходит от 110° (открыто) до 3° — за 3° до мёртвой точки; рука — до 2 Н·м (≈ 30 Н на рукояти).
  // Рукоять кончается на 76 мм от оси: в закрытом положении она не заходит в направляющую плунжера (x ≥ 78).
  "driver": { "type": "lever", "part": "handle", "range": [-107, 0], "handForce": 2 },
  "output": "plunger",

  "parts": [
    {
      "id": "handle",
      "name": "Рукоятка",
      // Рычажный зажим: рукоятка-кривошип 20 мм, тяга 45 мм, плунжер вдоль +X, упор-наковальня.
      "shape": [
        { "cylinder": { "r": 6, "z": [0, 6] } },
        { "box": [0, -4, 0, 20, 4, 5] },
        { "cylinder": { "at": [20, 0], "r": 4.5, "z": [0, 5] } },
        { "cylinder": { "at": [20, 0], "r": 2, "z": [5, 10], "segments": 24 } },
        { "box": [20, -4, 0, 56, 4, 5] },
        { "box": [56, -7, -1, 76, 7, 5] }  // рукоять: в закрытом положении не доходит до направляющей (x = 78)
      ],
      "color": "#D9534F",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1], "phase": 110 },
      "inertiaKgM2": 1.4e-5
    },
    {
      "id": "plunger",
      "name": "Плунжер",
      // Плунжер: начало координат — палец тяги.
      "shape": [
        { "cylinder": { "r": 2, "z": [5, 10.5], "segments": 24 } },  // палец в проушину тяги
        { "box": [-5, -5, 10, 10, 5, 14] },  // колодка над тягой (z 5,5…9)
        { "box": [8, -3, 5.5, 60, 3, 10] },
        { "box": [60, -7, 3.5, 64, 7, 12] }
      ],
      "color": "#FFA500",
      // При рукоятке на 110°: x = 20·cos 110° + √(45² − (20·sin 110°)²) = 34,05 мм.
      "joint": { "type": "prismatic", "origin": [34.047, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.01
    },
    {
      "id": "link",
      "name": "Тяга",
      "shape": [
        { "box": [0, -3, 5.5, 45, 3, 9] },
        { "cylinder": { "r": 4, "z": [5.5, 9] } },
        { "cylinder": { "at": [45, 0], "r": 4, "z": [5.5, 9] } }
      ],
      "color": "#B0B7C0",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "handle", "fromPoint": [20, 0, 0], "to": "plunger", "toPoint": [0, 0, 0] }
      }
    },
    {
      "id": "frame",
      "name": "Основание с направляющей и упором",
      "shape": [
        { "box": [-15, -20, -4, 137, 20, -2] },
        { "cylinder": { "r": 7, "z": [-2, 0] } },
        { "box": [78, 3, -2, 92, 7, 12] },  // направляющая плунжера
        { "box": [78, -7, -2, 92, -3, 12] },
        { "box": [78, -7, 12, 92, 7, 14] },
        { "box": [131, -12, -2, 137, 12, 14] }  // упор
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "crank-slider", "from": "handle", "to": "plunger", "crankMm": 20, "rodMm": 45, "offsetMm": 0 }
  ],

  "fasteners": [
    { "kind": "Ось рукоятки", "size": "Ø6×12", "type": "pin", "attachedTo": "handle", "note": "только в спецификации" },
    { "kind": "Палец тяги", "size": "Ø4×10", "type": "pin", "attachedTo": "handle", "count": 2, "note": "в модели — часть рукоятки и плунжера" },
    {
      "kind": "Винт крепления основания",
      "size": "M4×10",
      "type": "socket-screw",
      "diameterMm": 4,
      "lengthMm": 10,
      "positions": [[-10, -15, -2], [60, -17, -2], [125, -15, -2], [125, 15, -2]],
      "axis": [0, 0, -1],
      "attachedTo": "frame"
    }
  ]
}
