{
  "id": "cam-quick-return",
  "name": "Кулачок с быстрым возвратом",
  "category": "Кулачковые механизмы",
  "description": "Медленный подъём на 15 мм за 225°, быстрое опускание за 120° и выстой 15°; циклоидальный закон без ударов. Опускание быстрее 120° при этом базовом радиусе сделало бы профиль невыпуклым — толкатель оторвался бы от кулачка.",

  "motion": {"input": "rotation", "output": "linear"},
  "specs": {"strokeMm": 15, "maxForceN": 3, "maxSpeedRadS": 20},
  "envelopeMm": [55, 142, 80],

  "driver": {"type": "motor", "part": "cam", "motorGapMm": 6.0},
  "output": "follower",

  "parts": [
    {
      "id": "cam",
      "name": "Кулачок",
      "shape": [
        {"cam": {"z": [0, 8]}},
        {"cylinder": {"r": 6, "z": [-2, 10]}}
      ],
      "color": "#4682B4",
      "joint": {"type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1]},
      "inertiaKgM2": 3.605e-05
    },
    {
      "id": "follower",
      "name": "Толкатель",
      "shape": [
        {"box": [-18, 0, 0, 18, 3, 8]},
        {"box": [-3, 3, 2, 3, 45, 6]},
        {"box": [-6, 45, 1, 6, 49, 7]}
      ],
      "color": "#FFA500",
      "joint": {"type": "prismatic", "origin": [0, 24, 0], "axis": [0, 1, 0]},
      "massKg": 0.004
    },
    {
      "id": "frame",
      "name": "Стойка с направляющей",
      "shape": [
        {"box": [-27.5, 22, -4, 27.5, 73, -2]},
        {"box": [-9, 45, -2, -3.2, 65, 8]},
        {"box": [3.2, 45, -2, 9, 65, 8]}
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    {"type": "cam", "from": "cam", "to": "follower", "segments": [{"angleDeg": 225, "riseMm": 15, "law": "cycloidal"}, {"angleDeg": 120, "riseMm": -15, "law": "cycloidal"}, {"angleDeg": 15}]}
  ],

  "fasteners": [
    {"kind": "Пружина прижима толкателя", "size": "Ø8×25", "type": "spring", "attachedTo": "follower", "note": "в модели не показана: контакт обеспечивает кинематика"},
    {"kind": "Винт крепления стойки", "size": "M3×8", "type": "socket-screw", "diameterMm": 3, "lengthMm": 8, "positions": [[-22.5, 41, -2], [22.5, 41, -2]], "axis": [0, 0, -1], "attachedTo": "frame"}
  ]
}
