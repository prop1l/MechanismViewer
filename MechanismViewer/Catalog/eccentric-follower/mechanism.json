{
  "id": "eccentric-follower",
  "name": "Эксцентрик с плоским толкателем",
  "category": "Кулачковые механизмы",
  "description": "Диск Ø50, смещённый на 5 мм от оси вала, двигает плоский толкатель на 10 мм по гармоническому закону: s = e·(1 − cos θ), без выстоев. Самый простой кулачок — обычный круг на эксцентричной ступице.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 10, "maxForceN": 3, "maxSpeedRadS": 30 },
  "envelopeMm": [56, 120, 80],

  "driver": { "type": "motor", "part": "eccentric", "motorGapMm": 6.0 },
  "output": "follower",

  "parts": [
    {
      "id": "eccentric",
      "name": "Эксцентрик",
      // Контур строится по закону связи cam: для плоского толкателя гармонический закон 180°/180° даёт окружность
      // радиуса r_б + h/2 = 25, смещённую на h/2 = 5. Ступица — до z 10 (к ней прижимает ступица мотора).
      "shape": [
        { "cam": { "z": [0, 8] } },
        { "cylinder": { "r": 6, "z": [-2, 10] } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1], "phase": 0 },
      // Диск Ø50×8 PLA со смещением 5 мм: J = m·(r²/2 + e²).
      "inertiaKgM2": 6.6e-6
    },
    {
      "id": "follower",
      "name": "Толкатель",
      // Тарелка лежит на базовой окружности (20 мм) над осью; шток проходит между щеками направляющей.
      "shape": [
        { "box": [-16, 0, 0, 16, 3, 8] },
        { "box": [-3, 3, 2, 3, 49, 6] },
        { "box": [-6, 45, 1, 6, 49, 7] }
      ],
      "color": "#FFA500",
      "joint": { "type": "prismatic", "origin": [0, 20, 0], "axis": [0, 1, 0] },
      "massKg": 0.004
    },
    {
      "id": "frame",
      "name": "Стойка с направляющей",
      // Стенка выше кронштейна мотора (y ≥ 22); щёки направляющей ниже головки толкателя (она не опускается ниже y 65).
      "shape": [
        { "box": [-26, 22, -4, 26, 64, -2] },
        { "box": [-9, 50, -2, -3.2, 62, 8] },
        { "box": [3.2, 50, -2, 9, 62, 8] }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    {
      "type": "cam",
      "from": "eccentric",
      "to": "follower",
      "segments": [
        { "angleDeg": 180, "riseMm": 10, "law": "harmonic" },
        { "angleDeg": 180, "riseMm": -10, "law": "harmonic" }
      ]
    }
  ],

  "fasteners": [
    { "kind": "Пружина прижима толкателя", "size": "Ø8×25", "type": "spring", "attachedTo": "follower", "note": "в модели не показана: контакт обеспечивает кинематика" },
    {
      "kind": "Винт крепления стойки",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      // Вне круга, который заметает эксцентрик (r до 30).
      "positions": [[-21, 30, -2], [21, 30, -2]],
      "axis": [0, 0, -1],
      "attachedTo": "frame"
    }
  ]
}
