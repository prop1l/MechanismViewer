{
  "id": "button-rack-pinion",
  "name": "Кнопка с реечным поворотом стрелки",
  "category": "Кнопки и толкатели",
  "description": "Нажатие кнопки на 8 мм через рейку на толкателе поворачивает шестерню m1 z12 со стрелкой на 76°. Возвращает кнопку пружина сжатия.",

  "motion": { "input": "linear", "output": "rotation" },
  "specs": { "strokeMm": 8, "angleDeg": 76.4, "maxTorqueNm": 0.01 },
  "envelopeMm": [44, 54, 14],

  // Пружина 0,2 Н/мм с предварительным поджатием 0,5 Н; палец давит с силой 3 Н.
  "driver": {
    "type": "button",
    "part": "button",
    "range": [0, 8],
    "handForce": 3,
    "spring": { "stiffness": 0.2, "preload": 0.5 }
  },
  "output": "pinion",

  "parts": [
    {
      "id": "button",
      "name": "Кнопка с толкателем",
      // Кнопка с толкателем: делительная прямая рейки x = 3, зубья смотрят на шестерню (+X).
      "shape": [
        { "box": [-3, 0, 0, 1.75, 30, 6] },
        { "rack": { "origin": [3, 15], "direction": [0, -1], "module": 1, "teeth": [-4, 4], "z": [0, 6] } },
        { "box": [-9, 30, -2, 9, 36, 8] }
      ],
      "color": "#D9534F",
      // Нажатие — вниз (−Y).
      "joint": { "type": "prismatic", "origin": [0, 0, 0], "axis": [0, -1, 0] },
      "massKg": 0.0025
    },
    {
      "id": "pinion",
      "name": "Шестерня со стрелкой",
      // Шестерня m1 z12 со стрелкой вдоль +X. Впадина слева (180°), напротив рейки: зубья на 15° + 30°·k.
      "shape": [
        { "gear": { "module": 1, "teeth": 12, "phaseDeg": 15, "z": [0, 6] } },
        { "cylinder": { "r": 2.5, "z": [-2, 9] } },
        { "polygon": { "points": [[0, -1.2], [16, -0.4], [16, 0.4], [0, 1.2]], "z": [6, 8] } }
      ],
      "color": "#FFA500",
      // В STL впадина зубьев стоит слева (180°), напротив рейки толкателя.
      "joint": { "type": "revolute", "origin": [9, 15, 0], "axis": [0, 0, 1] },
      "gear": { "teeth": 12, "pitchRadiusMm": 6, "rootRadiusMm": 4.75, "thicknessMm": 6 },
      "inertiaKgM2": 3.5e-8
    },
    {
      "id": "spring",
      "name": "Пружина сжатия",
      // Пружина вдоль +X длиной 14 мм (окно растягивает её между точками крепления).
      "shape": [
        { "ringX": { "x": [0, 0.8], "r": [1.5, 3.5] } },
        { "ringX": { "x": [1.67, 2.57], "r": [2.4, 3.4] } },
        { "ringX": { "x": [3.44, 4.34], "r": [2.4, 3.4] } },
        { "ringX": { "x": [5.21, 6.11], "r": [2.4, 3.4] } },
        { "ringX": { "x": [6.98, 7.88], "r": [2.4, 3.4] } },
        { "ringX": { "x": [8.75, 9.65], "r": [2.4, 3.4] } },
        { "ringX": { "x": [10.52, 11.42], "r": [2.4, 3.4] } },
        { "ringX": { "x": [13.2, 14], "r": [1.5, 3.5] } }
      ],
      "color": "#C8CCD2",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "housing", "fromPoint": [0, -14, 3], "to": "button", "toPoint": [0, 0, 3], "stretchLengthMm": 14 }
      }
    },
    {
      "id": "housing",
      "name": "Корпус",
      "shape": [
        { "box": [-12, -18, -4, 32, 30, -2] },
        { "box": [-10, -18, -2, 20, -14, 8] },
        { "box": [-7, -14, -2, -4, 21.5, 6] }  // ниже головки нажатой кнопки (y = 30 − 8)
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "rack", "from": "button", "to": "pinion" }
  ],

  "fasteners": [
    { "kind": "Пружина сжатия", "size": "Ø7×14, 0,2 Н/мм", "type": "spring", "attachedTo": "spring", "note": "показана как деталь «Пружина сжатия»" },
    { "kind": "Ось шестерни", "size": "Ø5×11", "type": "pin", "attachedTo": "pinion", "note": "в модели — ступица шестерни" },
    {
      "kind": "Саморез крепления корпуса",
      "size": "2,2×6",
      "type": "self-tapping",
      "diameterMm": 2.2,
      "lengthMm": 6,
      // В лицевую сторону задней стенки (z = −2), вне хода стрелки.
      "positions": [[28, 26, -2], [28, -15, -2]],
      "axis": [0, 0, -1],
      "attachedTo": "housing"
    }
  ]
}
