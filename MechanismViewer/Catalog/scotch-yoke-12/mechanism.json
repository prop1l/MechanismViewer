{
  "id": "scotch-yoke-12",
  "name": "Синусный механизм с кулисой, кривошип 12 мм",
  "category": "Рычажные механизмы",
  "description": "Палец кривошипа 12 мм ходит в вертикальной прорези кулисы и двигает её вместе со штоком. Шатуна нет, поэтому ход 24 мм меняется строго по синусу, без искажения, как у кривошипно-ползунного механизма: механизм компактнее и симметричен на прямом и обратном ходе.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 24, "maxForceN": 0.5, "maxSpeedRadS": 20 },
  "envelopeMm": [110, 45, 60],

  // Вал мотора кончается в ступице кривошипа: над ней ходит кулиса.
  "driver": { "type": "motor", "part": "crank", "motorGapMm": 6.0, "shaftEndMm": 4.5 },
  "output": "yoke",

  "parts": [
    {
      "id": "crank",
      "name": "Кривошип",
      // Ось вращения — Z через начало координат, палец на (12, 0), выше плеча (z 5…13) — в прорези кулисы.
      "shape": [
        { "cylinder": { "r": 6, "z": [0, 5] } },
        { "box": [0, -4, 0, 12, 4, 5] },
        { "cylinder": { "at": [12, 0], "r": 4, "z": [0, 5] } },
        { "cylinder": { "at": [12, 0], "r": 2, "z": [5, 13], "segments": 24 } }
      ],
      "color": "#4682B4",
      // Угол 0° — палец на оси штока (+X): кулиса в правом крайнем положении.
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1], "phase": 0 },
      "inertiaKgM2": 1.2e-7
    },
    {
      "id": "yoke",
      "name": "Кулиса со штоком",
      // Начало координат — на оси прорези. Прорезь вдоль Y шириной 5 мм (палец Ø4), длина ±14,5 мм — палец ходит по ±12.
      // Шток вдоль +X проходит в U-образной направляющей.
      "shape": [
        { "box": [2.5, -17.5, 6, 6, 17.5, 11] },
        { "box": [-6, -17.5, 6, -2.5, 17.5, 11] },
        { "box": [-6, 14.5, 6, 6, 17.5, 11] },
        { "box": [-6, -17.5, 6, 6, -14.5, 11] },
        { "box": [6, -3, 6, 75, 3, 11] },
        { "box": [71, -5, 6, 75, 5, 16] }  // упор-толкатель на конце штока
      ],
      "color": "#FFA500",
      // При угле кривошипа 0° ось прорези на x = 12; ход от −12 до +12.
      "joint": { "type": "prismatic", "origin": [12, 0, 0], "axis": [1, 0, 0], "phase": 0 },
      // Кулиса + шток, PLA.
      "massKg": 0.0045
    },
    {
      "id": "guide",
      "name": "Направляющая штока",
      // U-образная направляющая (x 40…58) на стойке; основание правее мотора.
      "shape": [
        { "box": [30, -12, -4, 62, 12, -2] },
        { "box": [40, -7, -2, 58, 7, 5.7] },
        { "box": [40, 3.3, 5.7, 58, 7, 13] },
        { "box": [40, -7, 5.7, 58, -3.3, 13] },
        { "box": [40, -7, 11.3, 58, 7, 13] }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "yoke", "from": "crank", "to": "yoke", "crankMm": 12 }
  ],

  "fasteners": [
    { "kind": "Палец кривошипа", "size": "Ø4×13", "type": "pin", "attachedTo": "crank", "note": "в модели — часть кривошипа" },
    { "kind": "Стопорный винт ступицы", "size": "M3×4", "type": "set-screw", "attachedTo": "crank", "note": "входит в модель мотора" },
    {
      "kind": "Винт крепления направляющей",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      "positions": [[34, 8, -2], [34, -8, -2]],
      "axis": [0, 0, -1],
      "attachedTo": "guide"
    }
  ]
}
