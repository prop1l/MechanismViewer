{
  "id": "slotted-lever-quick-return",
  "name": "Механизм с качающейся кулисой (быстрый возврат)",
  "category": "Рычажные механизмы",
  "description": "Палец кривошипа 15 мм скользит в прорези кулисы, ось которой стоит в 40 мм от оси кривошипа. Кулиса качается на 44°, причём в одну сторону — за 224° оборота кривошипа, а обратно — за 136°: обратный ход в 1,65 раза быстрее рабочего. Так устроен привод поперечно-строгального станка.",

  "motion": { "input": "rotation", "output": "oscillation" },
  "specs": { "angleDeg": 44.0, "maxTorqueNm": 0.02, "maxSpeedRadS": 20 },
  "envelopeMm": [125, 60, 60],

  // Вал мотора кончается в ступице кривошипа: над ней ходит кулиса.
  "driver": { "type": "motor", "part": "crank", "motorGapMm": 6.0, "shaftEndMm": 4.5 },
  "output": "lever",

  "parts": [
    {
      "id": "crank",
      "name": "Кривошип",
      // Ось — Z через начало координат, палец на (15, 0), выше плеча (z 5…13) — в прорези кулисы.
      "shape": [
        { "cylinder": { "r": 6, "z": [0, 5] } },
        { "box": [0, -4, 0, 15, 4, 5] },
        { "cylinder": { "at": [15, 0], "r": 4, "z": [0, 5] } },
        { "cylinder": { "at": [15, 0], "r": 2, "z": [5, 13], "segments": 24 } }
      ],
      "color": "#4682B4",
      // Угол 0° — палец на продолжении линии «ось кулисы → ось кривошипа»: кулиса в среднем положении.
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1], "phase": 0 },
      "inertiaKgM2": 1.6e-7
    },
    {
      "id": "lever",
      "name": "Кулиса",
      // Ось качания — начало координат, прорезь вдоль +X шириной 5 мм: палец Ø4 бывает от оси на 25…55 мм.
      // Кулиса выше кривошипа (z 6…11); за прорезью — указатель до 85 мм.
      "shape": [
        { "cylinder": { "r": 6, "z": [0, 11] } },
        { "box": [0, -4, 6, 20, 4, 11] },
        { "box": [20, 2.5, 6, 60, 6, 11] },
        { "box": [20, -6, 6, 60, -2.5, 11] },
        { "box": [60, -4, 6, 85, 4, 11] },
        { "polygon": { "points": [[85, -4], [92, 0], [85, 4]], "z": [6, 11] } }
      ],
      "color": "#FFA500",
      // Ось кулисы на 40 мм левее оси кривошипа; начальный угол — из геометрии (решатель проверяет).
      "joint": { "type": "revolute", "origin": [-40, 0, 0], "axis": [0, 0, 1], "phase": 0 },
      // Длинная кулиса с указателем, PLA.
      "inertiaKgM2": 4.5e-6
    },
    {
      "id": "frame",
      "name": "Стойка",
      // Плита под осью кулисы — левее мотора; бобышка оси.
      "shape": [
        { "box": [-58, -16, -4, -24, 16, -2] },
        { "cylinder": { "at": [-40, 0], "r": 7, "z": [-2, -0.2] } }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "slotted-lever", "from": "crank", "to": "lever", "crankMm": 15 }
  ],

  "fasteners": [
    { "kind": "Палец кривошипа", "size": "Ø4×13", "type": "pin", "attachedTo": "crank", "note": "в модели — часть кривошипа" },
    { "kind": "Ось кулисы", "size": "Ø5×14", "type": "pin", "attachedTo": "lever", "note": "только в спецификации" },
    { "kind": "Стопорный винт ступицы", "size": "M3×4", "type": "set-screw", "attachedTo": "crank", "note": "входит в модель мотора" },
    {
      "kind": "Винт крепления стойки",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      "positions": [[-53, 11, -2], [-53, -11, -2]],
      "axis": [0, 0, -1],
      "attachedTo": "frame"
    }
  ]
}
