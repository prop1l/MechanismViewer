{
  "id": "gearbox-slider-indicator",
  "name": "Редуктор 1:9 с ползуном и указателем хода",
  "category": "Комбинированные механизмы",
  "description": "Двухступенчатый зубчатый редуктор m1 (12/36 · 12/36 = 1:9) вращает колесо с кривошипом 12 мм. Шатун 40 мм двигает ползун в направляющих на 24 мм, а рейка на ползуне поворачивает стрелку указателя на 229°. Восемь деталей: шестерня на валу мотора, блок-шестерня, колесо с кривошипом, шатун, ползун с рейкой, шестерня указателя и основание с осями и рельсами.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 24, "maxForceN": 5, "maxSpeedRadS": 60 },
  "envelopeMm": [116, 76, 97],

  // Мотор на оси ведущей шестерни; его ступица прижимает шестерню по торцу z = 6.
  "driver": { "type": "motor", "part": "pinion", "motorGapMm": 6.0, "hubSeatMm": 6.0 },
  "output": "slider",

  "parts": [
    {
      "id": "pinion",
      "name": "Ведущая шестерня z12",
      // Ведущая шестерня на валу мотора, зуб на 0° — к блоку.
      "shape": [
        { "gear": { "module": 1, "teeth": 12, "z": [0, 6] } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      "gear": { "teeth": 12, "pitchRadiusMm": 6, "rootRadiusMm": 4.75, "thicknessMm": 6 }
    },
    {
      "id": "cluster",
      "name": "Блок-шестерня z36/z12",
      // Блок-шестерня: z36 — впадина на 180° (к ведущей), z12 — зуб на 90° (к колесу).
      "shape": [
        { "gear": { "module": 1, "teeth": 36, "phaseDeg": 185, "z": [0, 6] } },
        { "gear": { "module": 1, "teeth": 12, "phaseDeg": 90, "z": [7, 13] } },
        { "cylinder": { "r": 4.5, "z": [-1, 14] } }
      ],
      "color": "#6B8E23",
      // Межосевое 24 мм = 6 + 18; z36 (слой 0…6) — от ведущей, z12 (слой 7…13) — на колесо.
      "joint": { "type": "revolute", "origin": [24, 0, 0], "axis": [0, 0, 1] },
      "gear": { "teeth": 36, "pitchRadiusMm": 18, "rootRadiusMm": 16.75, "thicknessMm": 9 }
    },
    {
      "id": "crankGear",
      "name": "Колесо z36 с кривошипом",
      // Колесо z36 (впадина на 270° — к блоку) с кривошипом: палец на (12, 0) под шатун.
      "shape": [
        { "gear": { "module": 1, "teeth": 36, "phaseDeg": 275, "z": [7, 13] } },
        { "cylinder": { "r": 4, "z": [-1, 14] } },
        { "box": [0, -3, 13, 12, 3, 14] },
        { "cylinder": { "at": [12, 0], "r": 4, "z": [13, 14.6] } },
        { "cylinder": { "at": [12, 0], "r": 2, "z": [13, 19.2], "segments": 24 } }
      ],
      "color": "#8B5A2B",
      // Угол 0° — палец кривошипа на оси ползуна (+X).
      "joint": { "type": "revolute", "origin": [24, 24, 0], "axis": [0, 0, 1], "phase": 0 },
      "gear": { "teeth": 36, "pitchRadiusMm": 18, "rootRadiusMm": 16.75, "thicknessMm": 7 }
    },
    {
      "id": "slider",
      "name": "Ползун с рейкой",
      // Ползун: начало координат — его палец. Корпус между рельсами (|y| < 7,5), мостик над рельсом +y
      // несёт рейку снаружи; делительная прямая рейки y = 15,25, зуб k = 0 на x = −12 (под указателем при q = 0).
      "shape": [
        { "cylinder": { "r": 2, "z": [14.7, 19.7], "segments": 24 } },
        { "box": [-9, -7, 19.5, 9, 7, 25.5] },
        { "box": [-9, -7, 25.5, 9, 14, 28] },
        { "box": [-20, 11.5, 19.5, 18, 14, 28] },
        { "rack": { "origin": [-12, 15.25], "module": 1, "teeth": [-2, 9], "z": [19.5, 25.5] } }
      ],
      "color": "#FFA500",
      // При кривошипе на 0° палец ползуна на r + L = 52 мм от оси колеса.
      "joint": { "type": "prismatic", "origin": [76, 24, 0], "axis": [1, 0, 0], "phase": 0 },
      // Ползун с рейкой + половина массы шатуна.
      "massKg": 0.006
    },
    {
      "id": "indicator",
      "name": "Шестерня указателя со стрелкой",
      // Шестерня указателя: впадина на 270° — над зубом рейки; стрелка вдоль +X над всеми деталями.
      "shape": [
        { "gear": { "module": 1, "teeth": 12, "phaseDeg": 285, "z": [19.5, 25.5] } },
        { "cylinder": { "r": 4, "z": [19, 28.5] } },
        { "polygon": { "points": [[0, -1.5], [17, -0.4], [17, 0.4], [0, 1.5]], "z": [28.5, 30] } },
        { "cylinder": { "r": 3, "z": [28.5, 30] } }
      ],
      "color": "#D9534F",
      // Над делительной прямой рейки (y = 24 + 15,25) на радиус 6 мм.
      "joint": { "type": "revolute", "origin": [64, 45.25, 0], "axis": [0, 0, 1] },
      "gear": { "teeth": 12, "pitchRadiusMm": 6, "rootRadiusMm": 4.75, "thicknessMm": 6 }
    },
    {
      "id": "rod",
      "name": "Шатун",
      // Шатун 40 мм: от пальца кривошипа вдоль +X.
      "shape": [
        { "box": [0, -2.5, 15.2, 40, 2.5, 18.7] },
        { "cylinder": { "r": 4, "z": [15.2, 18.7] } },
        { "cylinder": { "at": [40, 0], "r": 4, "z": [15.2, 18.7] } }
      ],
      "color": "#B0B7C0",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "crankGear", "fromPoint": [12, 0, 0], "to": "slider", "toPoint": [0, 0, 0] }
      }
    },
    {
      "id": "frame",
      "name": "Основание с осями и рельсами",
      "shape": [
        { "box": [20, -22, -4, 98, 52, -2] },  // плита — за кронштейном мотора (|x| ≤ 18)
        { "cylinder": { "at": [24, 0], "r": 5, "z": [-2, -1.3] } },  // опорная шайба
        { "cylinder": { "at": [24, 24], "r": 5, "z": [-2, -1.3] } },
        { "cylinder": { "at": [24, 0], "r": 2, "z": [-2, 14.8] } },  // ось
        { "cylinder": { "at": [24, 24], "r": 2, "z": [-2, 14.8] } },
        { "cylinder": { "at": [64, 45.25], "r": 4.5, "z": [-2, 18.6] } },  // стойка указателя
        { "cylinder": { "at": [64, 45.25], "r": 2, "z": [-2, 31] } },
        // Рельсы ползуна над шатуном (z > 18,7), консолью от задней стойки (за ходом ползуна, x ≤ 85).
        { "box": [43, 31.5, 19.2, 95, 34.5, 25] },
        { "box": [43, 13.5, 19.2, 95, 16.5, 25] },
        { "box": [88, 13.5, -2, 95, 34.5, 19.2] }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "gear", "from": "pinion", "to": "cluster", "ratio": -0.333333333333 },
    { "type": "gear", "from": "cluster", "to": "crankGear", "ratio": -0.333333333333 },
    { "type": "crank-slider", "from": "crankGear", "to": "slider", "crankMm": 12, "rodMm": 40, "offsetMm": 0 },
    { "type": "rack", "from": "slider", "to": "indicator" }
  ],

  // Оси блок-шестерни, колеса и указателя — часть основания.
  "designedContacts": [["cluster", "frame"], ["crankGear", "frame"], ["indicator", "frame"]],

  "fasteners": [
    { "kind": "Стопорный винт ступицы", "size": "M3×4", "type": "set-screw", "attachedTo": "pinion", "note": "входит в модель мотора" },
    { "kind": "Ось блок-шестерни", "size": "Ø4×17", "type": "pin", "attachedTo": "frame", "note": "в модели — часть основания" },
    { "kind": "Ось колеса", "size": "Ø4×17", "type": "pin", "attachedTo": "frame", "note": "в модели — часть основания" },
    { "kind": "Ось указателя", "size": "Ø4×33", "type": "pin", "attachedTo": "frame", "note": "в модели — часть основания" },
    { "kind": "Палец кривошипа", "size": "Ø4×6", "type": "pin", "attachedTo": "crankGear", "note": "в модели — часть колеса" },
    { "kind": "Палец ползуна", "size": "Ø4×5", "type": "pin", "attachedTo": "slider", "note": "в модели — часть ползуна" },
    {
      "kind": "Стопорное кольцо оси",
      "size": "4",
      "type": "retaining-ring",
      "diameterMm": 4,
      // Над ступицами (z 14) под шатуном (z 15,2) и над стрелкой указателя (z 30).
      "positions": [[24, 0, 14.05], [24, 24, 14.05], [64, 45.25, 30.05]],
      "attachedTo": "frame"
    },
    {
      "kind": "Винт крепления основания",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      // Головки на плите — вне круга блок-шестерни (r 19, слой 0…6).
      "positions": [[50, -18, -2], [94, -18, -2], [94, 48, -2], [30, 48, -2]],
      "axis": [0, 0, -1],
      "attachedTo": "frame"
    }
  ]
}
