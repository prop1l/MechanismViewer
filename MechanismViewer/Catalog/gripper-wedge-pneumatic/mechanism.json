{
  "id": "gripper-wedge-pneumatic",
  "name": "Пневматический клиновой захват",
  "category": "Захваты и манипуляторы",
  "description": "Двухпальцевый захват, показан в разрезе. Воздух через штуцер внизу цилиндра поднимает поршень, сжимая пружину над ним. На штоке — клин: пластина с двумя пазами под 45°, в пазах ходят пальцы губок. Клин поднимается на 3,95 мм, пазы тянут пальцы к центру, и губки сходятся на кубике. Воздух сброшен — пружина опускает поршень, пазы разводят губки. Обе губки движутся одним клином, поэтому деталь всегда центрируется по оси захвата.",

  "motion": { "input": "linear", "output": "linear" },
  "specs": { "strokeMm": 3.95, "maxForceN": 20 },
  "envelopeMm": [30, 73, 18],

  // Нажать и держать шток — подать воздух (≈ 22 Н на поршне при 0,2 МПа); отпустить — возврат пружиной.
  "driver": {
    "type": "button",
    "part": "piston",
    "range": [0, 3.95],
    "handForce": 22,
    "spring": { "stiffness": 0.5, "preload": 2 }
  },
  "output": "jaw-r",

  "parts": [
    {
      "id": "piston",
      "name": "Поршень со штоком и клином",
      // Поршень в расточке (над ним пружина, под ним — воздух), шток через нижнюю крышку, внизу — клин с пазами.
      // Пазы: центровые линии x = ±(y + 21), ширина 2,8 мм поперёк паза; открыты снизу.
      "shape": [
        { "box": [-5, 4, -3, 5, 7, 3] },
        { "box": [-1.5, -9, -2, 1.5, 4, 2] },
        {
          "polygon": {
            "points": [
              [-15, -18], [-4.98, -18], [-12.48, -10.5], [-8.52, -10.5], [-1.02, -18],
              [1.02, -18], [8.52, -10.5], [12.48, -10.5], [4.98, -18],
              [15, -18], [15, -8.5], [-15, -8.5]
            ],
            "z": [-2, 2]
          }
        }
      ],
      "color": "#4682B4",
      // Воздух поднимает поршень (+Y).
      "joint": { "type": "prismatic", "origin": [0, -30, 0], "axis": [0, 1, 0] },
      "massKg": 0.004
    },
    {
      "id": "jaw-r",
      "name": "Губка правая",
      // Корпус губки — за клином (z −6…−2,2), палец Ø2,4 вперёд в паз клина; ниже — палец захвата (раскрыт — x = 9).
      "shape": [
        { "box": [6, -48.5, -6, 14, -34.1, -2.2] },
        // Крючок: стенка за задним рельсом и губа, лежащая на рельсе сверху.
        { "box": [6, -36, -10.6, 14, -34.1, -6] },
        { "box": [6, -34.1, -10.6, 14, -29.9, -9.2] },
        { "box": [6, -31.8, -9.2, 14, -29.9, -6.2] },
        { "cylinder": { "at": [9, -42], "r": 1.2, "z": [-2.2, 2], "segments": 20 } },
        { "box": [9, -62, -11, 13, -48.5, 1] }
      ],
      "color": "#FFA500",
      // Подъём клина на p сводит губку на p (паз под 45°).
      "joint": { "type": "prismatic", "origin": [0, 0, 0], "axis": [-1, 0, 0] },
      "massKg": 0.002
    },
    {
      "id": "jaw-l",
      "name": "Губка левая",
      "shape": [
        { "box": [-14, -48.5, -6, -6, -34.1, -2.2] },
        { "box": [-14, -36, -10.6, -6, -34.1, -6] },
        { "box": [-14, -34.1, -10.6, -6, -29.9, -9.2] },
        { "box": [-14, -31.8, -9.2, -6, -29.9, -6.2] },
        { "cylinder": { "at": [-9, -42], "r": 1.2, "z": [-2.2, 2], "segments": 20 } },
        { "box": [-13, -62, -11, -9, -48.5, 1] }
      ],
      "color": "#FFA500",
      "joint": { "type": "prismatic", "origin": [0, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.002
    },
    {
      "id": "spring",
      "name": "Пружина возврата",
      // Между верхней крышкой и поршнем (зазоры 0,2 мм): 14,6 мм в разведённом положении, 10,65 мм при поданном воздухе.
      "shape": [
        { "ringX": { "x": [0, 0.8], "r": [2.2, 3] } },
        { "ringX": { "x": [2.3, 3.1], "r": [2.2, 3] } },
        { "ringX": { "x": [4.6, 5.4], "r": [2.2, 3] } },
        { "ringX": { "x": [6.9, 7.7], "r": [2.2, 3] } },
        { "ringX": { "x": [9.2, 10], "r": [2.2, 3] } },
        { "ringX": { "x": [11.5, 12.3], "r": [2.2, 3] } },
        { "ringX": { "x": [14.2, 15], "r": [2.2, 3] } }
      ],
      "color": "#C8CCD2",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "body", "fromPoint": [0, -8.2, 0], "to": "piston", "toPoint": [0, 7.2, 0], "stretchLengthMm": 15 }
      }
    },
    {
      "id": "body",
      "name": "Корпус с цилиндром (разрез)",
      // Цилиндр разрезан по z = 0: видны поршень, пружина и шток. Расточка x ±5,2; нижняя крышка с отверстием под шток.
      "shape": [
        { "box": [-8, -30, -6, -5.2, -8, 0] },
        { "box": [5.2, -30, -6, 8, -8, 0] },
        { "box": [-5.2, -30, -6, 5.2, -8, -3.2] },
        { "box": [-5.2, -30, -3.2, -1.8, -27, 0] },
        { "box": [1.8, -30, -3.2, 5.2, -27, 0] },
        { "box": [-8, -8, -6, 8, -5, 0] },
        { "box": [8, -29.5, -4, 11, -27.5, -1] },
        { "box": [-14, -5, -6, 14, -2, 6] },
        { "box": [-16, -34, -6, 16, -30, -2.2] },
        // Задний рельс губок: на нём крючками висят губки.
        { "box": [-16, -34, -9, 16, -32, -6] }
      ],
      "color": "#B0B7C0"
    },
    {
      "id": "workpiece",
      "name": "Кубик 10 мм",
      "shape": [ { "box": [-5, -62, -10, 5, -52, 0] } ],
      "color": "#8FBC8F"
    },
    {
      "id": "stand",
      "name": "Подставка",
      "shape": [
        { "box": [-4, -72, -9, 4, -62.1, -1] },
        { "box": [-18, -75, -14, 18, -72, 4] }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "wedge", "from": "piston", "to": "jaw-r", "angleDeg": 45 },
    { "type": "wedge", "from": "piston", "to": "jaw-l", "angleDeg": 45 }
  ],

  "fasteners": [
    { "kind": "Пружина возврата поршня", "size": "Ø6×15, 0,5 Н/мм", "type": "spring", "attachedTo": "spring", "note": "показана как деталь «Пружина возврата»" },
    { "kind": "Штуцер подачи воздуха", "size": "M5", "attachedTo": "body", "note": "в модели — выступ сбоку внизу цилиндра" },
    { "kind": "Пальцы губок", "size": "Ø2,4×4", "type": "pin", "count": 2, "attachedTo": "jaw-r", "note": "в модели — части губок" },
    {
      "kind": "Винт крепления к фланцу робота",
      "size": "M3×6",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 6,
      "positions": [[-11.5, -2, 0], [11.5, -2, 0]],
      "axis": [0, -1, 0],
      "attachedTo": "body"
    }
  ]
}
