{
  "id": "worm-1-20",
  "name": "Червячная пара 1:20",
  "category": "Зубчатые передачи",
  "description": "Однозаходный червяк m1,5 на валу мотора вращает колесо z20 вокруг перпендикулярной оси. Большое понижение в одной ступени; при малом угле подъёма витка передача самотормозящая.",

  "motion": { "input": "rotation", "output": "rotation" },
  "specs": { "ratio": 0.05, "maxTorqueNm": 0.12, "maxSpeedRadS": 40 },
  "envelopeMm": [44, 63, 120],

  "driver": { "type": "motor", "part": "worm", "motorGapMm": 6.0 },
  "output": "wheel",

  "parts": [
    {
      "id": "worm",
      "name": "Червяк",
      // Червяк m1,5 однозаходный, ось Z: делительный радиус 7,5, шаг π·m.
      "shape": [
        { "cylinder": { "r": 5.625, "z": [2, 40] } },
        // Начало витка — так, чтобы впадина под осью колеса (z = 21) была по центру зуба колеса:
        // на угле 90° середина впадины на z0 + p·(k + 1/4) + p/2.
        { "thread": { "r": [5.625, 9], "pitch": 4.712389, "z": [3.328541, 38], "width": [3, 1.2] } },
        { "cylinder": { "r": 3, "z": [0, 46] } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      "inertiaKgM2": 1.9e-7
    },
    {
      "id": "wheel",
      "name": "Червячное колесо z20",
      // Колесо z20 m1,5, ось X: строится в плоскости XY и переносится (x, y, z) → (z, y, x).
      "shape": [
        { "gear": { "module": 1.5, "teeth": 20, "z": [-5, 5] } },
        { "cylinder": { "r": 6, "z": [-8, 8] } },
        { "cylinder": { "r": 3, "z": [-15, 15] } },
        { "box": [-1.5, 0, 5, 1.5, 12, 6.5] }  // метка на торце — видно вращение
      ],
      "shapeAxis": "x",
      "color": "#FFA500",
      // Межосевое 7,5 + 15 = 22,5 мм, колесо над серединой червяка.
      "joint": { "type": "revolute", "origin": [0, 22.5, 21], "axis": [1, 0, 0] },
      "inertiaKgM2": 1.0e-6,
      "coulombFriction": 2e-4
    },
    {
      "id": "frame",
      "name": "Основание и стойки",
      "shape": [
        { "box": [-22, -24, -3.5, 22, -21.5, 50] },  // основание — от стенки кронштейна мотора
        { "box": [-8, -21.5, 44, 8, 4, 50] },  // передняя опора червяка
        { "box": [10, -21.5, 16, 14, 26, 26] },  // стойки оси колеса
        { "box": [-14, -21.5, 16, -10, 26, 26] }
      ],
      "color": "#5A606A"
    }
  ],

  // Один оборот червяка — один зуб колеса (1/20 оборота).
  "couplings": [
    { "type": "gear", "from": "worm", "to": "wheel", "ratio": 0.05 }
  ],

  // Ось колеса в стойках, конец червяка в передней опоре.
  "designedContacts": [["wheel", "frame"], ["worm", "frame"]],

  "fasteners": [
    { "kind": "Ось колеса", "size": "Ø6×30", "type": "pin", "attachedTo": "wheel", "note": "в модели — часть колеса" },
    { "kind": "Стопорный винт ступицы колеса", "size": "M3×4", "type": "set-screw", "attachedTo": "wheel", "note": "только в спецификации" },
    {
      "kind": "Винт крепления стоек",
      "size": "M3×10",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 10,
      // Снизу через основание: сверху стойки винт прошёл бы сквозь ось колеса (y 22,5).
      "positions": [[12, -24, 21], [-12, -24, 21]],
      "axis": [0, 1, 0],
      "attachedTo": "frame"
    }
  ]
}
