{
  "id": "ellipsograph",
  "name": "Эллипсограф с рукояткой",
  "category": "Рычажные механизмы",
  "description": "Два ползуна в крестообразных пазах соединены звеном 40 мм, рукоятка 20 мм вращает середину звена. Ползуны ходят по 80 мм каждый со сдвигом по фазе на четверть оборота, а перо на продолжении звена (15 мм за ползуном) чертит эллипс с полуосями 15 и 55 мм. Механизм Архимеда: вращение превращается в два гармонических движения.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 80, "maxForceN": 5 },
  "envelopeMm": [116, 116, 38],

  // Ручка: тянуть за шарик рукоятки по кругу, без упоров; рука — до 0,3 Н·м (≈ 11 Н на шарике).
  "driver": { "type": "crank", "part": "crank", "handForce": 0.3 },
  "output": "slider-x",

  "parts": [
    {
      "id": "crank",
      "name": "Рукоятка",
      // Ось — Z через центр доски; плечо над звеном (z 12…16), палец (20, 0) опущен в середину звена.
      // Ось держит консоль сверху (z ≥ 19), шарик рукоятки (r 27) проходит под ней.
      "shape": [
        { "cylinder": { "r": 5, "z": [12, 18.8] } },
        { "box": [0, -3.5, 12, 30, 3.5, 16] },
        { "cylinder": { "at": [20, 0], "r": 4, "z": [12, 16] } },
        { "cylinder": { "at": [20, 0], "r": 2, "z": [6.5, 12], "segments": 24 } },
        { "cylinder": { "at": [27, 0], "r": 3.5, "z": [16, 25.5], "segments": 32 } }
      ],
      "color": "#4682B4",
      // При 30° ползун X на 34,6 мм, ползун Y на 20 мм.
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1], "phase": 30 },
      "inertiaKgM2": 1.5e-6
    },
    {
      "id": "slider-x",
      "name": "Ползун X",
      // Колодка в пазу вдоль X (паз 8,6 мм) с пальцем звена.
      "shape": [
        { "box": [-6, -4, 0, 6, 4, 6] },
        { "cylinder": { "r": 2, "z": [6, 10], "segments": 24 } }
      ],
      "color": "#FFA500",
      // x = 40·cos θ: при θ = 30° — 34,64 мм.
      "joint": { "type": "prismatic", "origin": [34.641016, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.002
    },
    {
      "id": "slider-y",
      "name": "Ползун Y",
      "shape": [
        { "box": [-4, -6, 0, 4, 6, 6] },
        { "cylinder": { "r": 2, "z": [6, 10], "segments": 24 } }
      ],
      "color": "#FFA500",
      // y = 40·sin θ: при θ = 30° — 20 мм.
      "joint": { "type": "prismatic", "origin": [0, 20, 0], "axis": [0, 1, 0] },
      "massKg": 0.002
    },
    {
      "id": "rod",
      "name": "Звено с пером",
      // От пальца ползуна X (0) через середину (20, палец рукоятки) к пальцу ползуна Y (40); перо на 55.
      "shape": [
        { "box": [0, -2.5, 7, 55, 2.5, 10] },
        { "cylinder": { "r": 4, "z": [7, 10] } },
        { "cylinder": { "at": [20, 0], "r": 4, "z": [7, 10] } },
        { "cylinder": { "at": [40, 0], "r": 4, "z": [7, 10] } },
        { "cylinder": { "at": [55, 0], "r": 3, "z": [7, 11.5] } },
        { "cylinder": { "at": [55, 0], "r": 1.2, "z": [6.5, 7], "segments": 16 } }
      ],
      "color": "#B0B7C0",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "slider-x", "fromPoint": [0, 0, 0], "to": "slider-y", "toPoint": [0, 0, 0] }
      }
    },
    {
      "id": "board",
      "name": "Доска с крестообразными пазами",
      // Четыре квадранта оставляют между собой пазы шириной 8,6 мм; консоль оси рукоятки — из угла по диагонали.
      "shape": [
        { "box": [-52, -52, -3, 52, 52, -0.1] },
        { "box": [4.3, 4.3, -0.1, 52, 52, 6] },
        { "box": [-52, 4.3, -0.1, -4.3, 52, 6] },
        { "box": [-52, -52, -0.1, -4.3, -4.3, 6] },
        { "box": [4.3, -52, -0.1, 52, -4.3, 6] },
        { "box": [52, 52, -3, 64, 64, 30] },
        { "polygon": { "points": [[2.83, -2.83], [62.83, 57.17], [57.17, 62.83], [-2.83, 2.83]], "z": [26, 30] } },
        { "cylinder": { "r": 6, "z": [19, 30] } }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "yoke", "from": "crank", "to": "slider-x", "crankMm": 40 },
    { "type": "yoke", "from": "crank", "to": "slider-y", "crankMm": 40 }
  ],

  // Палец рукоятки входит в среднюю проушину звена.
  "designedContacts": [["crank", "rod"]],

  "fasteners": [
    { "kind": "Палец рукоятки", "size": "Ø4×10", "type": "pin", "attachedTo": "crank", "note": "в модели — часть рукоятки" },
    { "kind": "Пальцы ползунов", "size": "Ø4×4", "type": "pin", "count": 2, "attachedTo": "slider-x", "note": "в модели — часть ползунов" },
    { "kind": "Ось рукоятки", "size": "Ø5×18", "type": "pin", "attachedTo": "crank", "note": "только в спецификации" },
    {
      "kind": "Винт крепления квадрантов",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      "positions": [[46, -46, 6], [-46, -46, 6], [-46, 46, 6]],
      "axis": [0, 0, -1],
      "attachedTo": "board"
    }
  ]
}
