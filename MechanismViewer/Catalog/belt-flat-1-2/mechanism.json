      "color": "#FFA500",
      "joint": { "type": "revolute", "origin": [70, 0, 0], "axis": [0, 0, 1] },
      "inertiaKgM2": 2.6e-6
    },
    {
      "id": "belt",
      "name": "Плоский ремень",
      // Ремень 5 × 1,2 мм с зазором 0,1 мм над ободами; гладкий ремень в движении выглядит так же, как в покое.
      "shape": [
        { "belt": { "pulleys": [[0, 0, 10.1], [70, 0, 20.1]], "thickness": 1.2, "z": [1.5, 6.5], "segments": 96 } }
      ],
      "color": "#2B2B2E"
    },
    {
      "id": "frame",
      "name": "Стойка",
      // Плита под ведомым шкивом — правее мотора; бобышка оси.
      "shape": [
        { "box": [45, -27, -4, 97, 27, -2] },
        { "cylinder": { "at": [70, 0], "r": 7, "z": [-2, -1.2] } }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "belt", "from": "drive", "to": "driven", "ratio": 0.5 }
  ],

  "fasteners": [
    { "kind": "Ремень плоский", "size": "5×1,2, L ≈ 240", "attachedTo": "belt", "note": "показан как деталь «Плоский ремень»" },
    { "kind": "Ось ведомого шкива", "size": "Ø5×12", "type": "pin", "attachedTo": "driven", "note": "в модели — ступица шкива" },
    { "kind": "Стопорный винт ступицы", "size": "M3×4", "type": "set-screw", "attachedTo": "drive", "note": "входит в модель мотора" },
