{
  "id": "belt-flat-1-2",
  "name": "Плоскоременная передача 1:2",
  "category": "Ременные передачи",
  "description": "Плоский ремень охватывает ведущий шкив Ø20 на валу мотора и ведомый Ø40 на расстоянии 70 мм. Ведомый шкив вращается вдвое медленнее и в ту же сторону, в отличие от зубчатой пары. Ремень гасит толчки и позволяет разнести валы, но при перегрузке проскальзывает.",

  "motion": { "input": "rotation", "output": "rotation" },
  "specs": { "ratio": 0.5, "maxTorqueNm": 0.02, "maxSpeedRadS": 40 },
  "envelopeMm": [107, 50, 50],

  "driver": { "type": "motor", "part": "drive", "motorGapMm": 6.0, "hubSeatMm": 8.0 },
  "output": "driven",

  "parts": [
    {
      "id": "drive",
      "name": "Ведущий шкив",
      // Обод r 10 (под ремнём, z 1…7) между ребордами r 12,5; на торце — два ребра, чтобы было видно вращение.
      "shape": [
        { "cylinder": { "r": 10, "z": [1, 7] } },
        { "cylinder": { "r": 12.5, "z": [0, 1] } },
        { "cylinder": { "r": 12.5, "z": [7, 8] } },
        { "box": [6.5, -1.2, 8, 11.5, 1.2, 9] },
        { "box": [-11.5, -1.2, 8, -6.5, 1.2, 9] }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      "inertiaKgM2": 1.8e-7
    },
    {
      "id": "driven",
      "name": "Ведомый шкив",
      "shape": [
        { "cylinder": { "r": 20, "z": [1, 7], "segments": 72 } },
        { "cylinder": { "r": 22.5, "z": [0, 1], "segments": 72 } },
        { "cylinder": { "r": 22.5, "z": [7, 8], "segments": 72 } },
        { "cylinder": { "r": 5, "z": [-1, 9.5] } },
        { "box": [5, -1.5, 8, 19, 1.5, 9.5] },
        { "box": [-19, -1.5, 8, -5, 1.5, 9.5] },
        { "box": [-1.5, 5, 8, 1.5, 19, 9.5] },
        { "box": [-1.5, -19, 8, 1.5, -5, 9.5] }
