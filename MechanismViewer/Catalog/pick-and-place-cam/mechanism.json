{
  "id": "pick-and-place-cam",
  "name": "Кулачковый перекладчик с клиновым захватом",
  "category": "Захваты и манипуляторы",
  "description": "Перекладчик сборочной линии на одном моторе. Кулачок перемещения толкает рейку на 12,5 мм, сдвоенное колесо z12/z48 увеличивает ход в 4 раза и через рейку каретки переносит её на 50 мм. Кулачок подъёма опускает балку, а с ней и ползун каретки, который лежит на балке роликом. Третий кулачок поднимает балку захвата, на которой лежит роликом шток захвата: в нижних выстоях балка поднимается на 3,95 мм больше подъёмной, шток идёт вверх, и клин на нём пазами под 45° сводит пальцы губок. Балка опускается — пружина возвращает шток, губки расходятся. За оборот вала захват берёт кубик на загрузке, ставит на позицию обработки, ждёт, забирает и возвращает обратно.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 50, "maxForceN": 2, "maxSpeedRadS": 8 },
  "envelopeMm": [195, 170, 56],

  // Мотор за задней плитой; вал кончается в ступице распределительного вала.
  "driver": { "type": "motor", "part": "camshaft", "motorGapMm": 6.0, "shaftEndMm": 6.0 },
  "output": "carriage",

  "parts": [
    {
      "id": "camshaft",
      "name": "Распределительный вал с кулачками",
      // Задний кулачок (z 2…8) — подъём, средний (z 10…16) — перемещение (ролики Ø10), передний (z 43…49) — захват (ролик Ø6:
      // подъём на 3,95 мм за 14° даёт впадину профиля радиусом ≈ 5 мм, ролик Ø10 в неё не помещается).
      "shape": [
        { "cylinder": { "r": 6, "z": [0, 54] } },  // спереди вал входит в подшипник стойки (z 50,5…54)
        { "cam": { "z": [2, 8], "follower": "lift", "rollerRadius": 5 } },
        { "cam": { "z": [10, 16], "follower": "x-follower", "rollerRadius": 5 } },
        { "cam": { "z": [43, 49], "follower": "grip", "rollerRadius": 3 } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      "inertiaKgM2": 2.5e-6
    },
    {
      "id": "lift",
      "name": "Подъёмная балка",
      // Ролик над кулачком подъёма (центровой радиус 50), шток в направляющей, сверху — балка вдоль всего хода каретки.
      "shape": [
        { "cylinder": { "r": 5, "z": [2, 8], "segments": 32 } },
        { "box": [-3, 5, 3, 3, 32, 7] },
        { "box": [-5, 32, 2, 105, 36, 8] }
      ],
      "color": "#D9534F",
      "joint": { "type": "prismatic", "origin": [0, 50, 0], "axis": [0, 1, 0] },
      "massKg": 0.012
    },
    {
      "id": "grip",
      "name": "Балка захвата",
      // Как подъёмная балка, но спереди (z 43…49) и выше: на ней лежит роликом шток захвата.
      // Её закон — ход подъёма плюс ход клина: в выстоях внизу балка поднимается ещё на 3,95 мм и сводит губки.
      "shape": [
        { "cylinder": { "r": 3, "z": [43, 49], "segments": 32 } },
        { "box": [-2, 3, 44, 2, 50, 48] },
        { "box": [-5, 50, 43, 105, 54, 49] }
      ],
      "color": "#D9534F",
      "joint": { "type": "prismatic", "origin": [0, 50, 0], "axis": [0, 1, 0] },
      "massKg": 0.012
    },
    {
      "id": "x-follower",
      "name": "Толкатель с рейкой",
      // Ролик справа от кулачка перемещения (центровой радиус 40); рейка m1 сверху, впадина под шестерней на x = 30.
      "shape": [
        { "cylinder": { "r": 5, "z": [10, 16], "segments": 32 } },
        { "box": [3, -4, 11, 50, 2.75, 15] },
        { "rack": { "origin": [31.5708, 4.0], "direction": [1, 0], "module": 1, "teeth": [-8, 3], "z": [11, 15] } }
      ],
      "color": "#D9534F",
      "joint": { "type": "prismatic", "origin": [40, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.006
    },
    {
      "id": "transfer-gear",
      "name": "Сдвоенное колесо z12/z48",
      // Шестерня z12 (r 6) — от рейки толкателя, колесо z48 (r 24) — к рейке каретки: ход ×4.
      "shape": [
        { "gear": { "module": 1, "teeth": 12, "phaseDeg": 0, "z": [10, 16] } },
        { "gear": { "module": 1, "teeth": 48, "phaseDeg": 90, "z": [18, 24] } },
        { "cylinder": { "r": 4, "z": [7.8, 24.5] } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [70, 10.2, 0], "axis": [0, 0, 1] },
      "inertiaKgM2": 4.6e-6
    },
    {
      "id": "carriage",
      "name": "Каретка с рейкой",
      // Рейка снизу — на колесе z48; спереди — втулка вертикального ползуна. Начало — над позицией загрузки A (x = 95).
      "shape": [
        { "box": [-36, -4.35, 18, 36, 3, 24] },
        // Каретка охватывает рельс: передняя щека перед рельсом и губа, лежащая на нём сверху (зазоры 0,2–0,3 мм).
        { "box": [-36, 3, 23.9, 36, 9, 26] },
        { "box": [-36, 6.3, 18, 36, 9, 23.9] },
        { "rack": { "origin": [-23.4292, -5.6], "direction": [-1, 0], "module": 1, "teeth": [-19, 3], "z": [18, 24] } },
        // Втулка короче снизу: под ней на ползуне фланец цилиндра (y ≤ −2 при поднятом ползуне).
        { "box": [-6, -1, 24, 6, 6, 37] }
      ],
      "color": "#FFA500",
      // Колесо поворачивается против часовой — каретка едет влево, к позиции обработки B (x = 45).
      "joint": { "type": "prismatic", "origin": [95, 40, 0], "axis": [-1, 0, 0] },
      // Каретка с ползуном, захватом и деталью.
      "massKg": 0.04
    },
    {
      "id": "slide",
      "name": "Вертикальный ползун с цилиндром захвата",
      // Стоит на каретке. Сверху ролик лежит на подъёмной балке, внизу — корпус захвата, как у «Пневматического клинового захвата»,
      // сдвинутый на 5 мм вперёд (z −1…11), чтобы пальцы губок не задевали колесо z48. Вместо пневмоцилиндра — стакан пружины штока (в разрезе по z = 5).
      "shape": [
        { "box": [-3, -5, -3, 3, 55, 3] },
        { "box": [-3, 51, -29, 3, 55, 3] },
        { "cylinder": { "at": [0, 50.1], "r": 4, "z": [-29, -23], "segments": 32 } },
        { "box": [-8, -30, -1, -5.2, -8, 5] },
        { "box": [5.2, -30, -1, 8, -8, 5] },
        { "box": [-5.2, -30, -1, 5.2, -8, 1.8] },
        { "box": [-5.2, -30, 1.8, -1.8, -27, 5] },
        { "box": [1.8, -30, 1.8, 5.2, -27, 5] },
        { "box": [-8, -8, -1, 8, -5, 5] },
        { "box": [-14, -5, -1, 14, -2, 11] },
        { "box": [-16, -34, -1, 16, -30, 2.8] },
        // Задний рельс губок: на нём крючками висят губки.
        { "box": [-16, -34, -4, 16, -32, -1] }
      ],
      "color": "#B0B7C0",
      "joint": { "type": "prismatic", "parent": "carriage", "origin": [0, 0, 31], "axis": [0, 1, 0] },
      "massKg": 0.01
    },
    {
      "id": "piston",
      "name": "Шток захвата с клином",
      // Шток идёт вверх по оси пружины (z 4…6) через крышку стакана, фланец и втулку каретки; вверху — ролик, лежащий на балке захвата.
      // Внизу — упор под пружину, клин с пазами под 45°: центровые линии x = ±(y + 21), открыты снизу. Поднят на 3,95 мм — пазы свели губки.
      "shape": [
        { "box": [-5, 4, 2, 5, 7, 8] },
        { "box": [-1.5, -9, 3, 1.5, 4, 7] },
        { "box": [-1, 7, 4, 1, 98, 6] },
        { "box": [-1.5, 96, 4, 1.5, 100, 17.8] },
        { "cylinder": { "at": [0, 98.1], "r": 4, "z": [12.2, 17.8], "segments": 32 } },
        {
          "polygon": {
            "points": [
              [-15, -18], [-4.98, -18], [-12.48, -10.5], [-8.52, -10.5], [-1.02, -18],
              [1.02, -18], [8.52, -10.5], [12.48, -10.5], [4.98, -18],
              [15, -18], [15, -8.5], [-15, -8.5]
            ],
            "z": [3, 7]
          }
        }
      ],
      "color": "#4682B4",
      "joint": { "type": "prismatic", "parent": "slide", "origin": [0, -30, 0], "axis": [0, 1, 0] },
      "massKg": 0.004
