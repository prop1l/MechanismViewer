  // Цикл за оборот вала (A — загрузка, B — обработка):
  // 0–26° опускание на A, 26–40° захват, 40–66° подъём, 66–106° перенос на B, 106–132° опускание, 132–146° губки разводятся,
  // 146–172° подъём, 172–188° обработка, 188–214° опускание, 214–228° захват, 228–254° подъём, 254–294° перенос на A,
  // 294–320° опускание, 320–334° губки разводятся, 334–360° подъём.
  "couplings": [
    {
      "type": "cam", "from": "camshaft", "to": "lift",
      "segments": [
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 40, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 16, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 40, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }
      ]
    },
    {
      "type": "cam", "from": "camshaft", "to": "x-follower",
      "segments": [
        { "angleDeg": 66, "riseMm": 0 }, { "angleDeg": 40, "riseMm": 12.5, "law": "harmonic" },
        { "angleDeg": 148, "riseMm": 0 }, { "angleDeg": 40, "riseMm": -12.5, "law": "harmonic" }, { "angleDeg": 66, "riseMm": 0 }
      ]
    },
    { "type": "rack", "from": "x-follower", "to": "transfer-gear", "radiusMm": 6 },
    { "type": "rack", "from": "transfer-gear", "to": "carriage", "radiusMm": 24 },
    // Ползун лежит роликом на балке и повторяет её ход (тот же закон).
    {
      "type": "cam", "from": "camshaft", "to": "slide",
      "segments": [
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 40, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 16, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 40, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 0 }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }
      ]
    },
    // Шток захвата лежит роликом на балке захвата, а пружина прижимает его к балке. Относительно ползуна шток проходит
    // разность ходов балки захвата и подъёмной балки: 3,95 мм вверх в нижних выстоях — губки сходятся.
    {
      "type": "cam", "from": "camshaft", "to": "grip",
      "segments": [
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 3.95, "law": "harmonic" }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 40, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": -3.95, "law": "harmonic" }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 16, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": 3.95, "law": "harmonic" }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 40, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 14, "riseMm": -3.95, "law": "harmonic" }, { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }
      ]
    },
    {
      "type": "cam", "from": "camshaft", "to": "piston",
      "segments": [
        { "angleDeg": 26, "riseMm": 0 }, { "angleDeg": 14, "riseMm": 3.95, "law": "harmonic" }, { "angleDeg": 92, "riseMm": 0 }, { "angleDeg": 14, "riseMm": -3.95, "law": "harmonic" },
        { "angleDeg": 68, "riseMm": 0 }, { "angleDeg": 14, "riseMm": 3.95, "law": "harmonic" }, { "angleDeg": 92, "riseMm": 0 }, { "angleDeg": 14, "riseMm": -3.95, "law": "harmonic" },
        { "angleDeg": 26, "riseMm": 0 }
      ]
    },
    { "type": "wedge", "from": "piston", "to": "jaw-r", "angleDeg": 45 },
    { "type": "wedge", "from": "piston", "to": "jaw-l", "angleDeg": 45 },
    {
      "type": "cam", "from": "camshaft", "to": "workpiece",
      "segments": [
        { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 120, "riseMm": 0 }, { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }, { "angleDeg": 16, "riseMm": 0 },
        { "angleDeg": 26, "riseMm": 12, "law": "harmonic" }, { "angleDeg": 120, "riseMm": 0 }, { "angleDeg": 26, "riseMm": -12, "law": "harmonic" }
      ]
    }
  ],

  // Ползун — во втулке каретки; шток захвата проходит сквозь крышку стакана, фланец и втулку (отверстия не вырезаны).
  "designedContacts": [["slide", "carriage"], ["piston", "slide"], ["piston", "carriage"], ["camshaft", "frame"], ["transfer-gear", "frame"]],

  "fasteners": [
