    {
      "id": "jaw-r",
      "name": "Губка правая",
      // Корпус губки — за клином (z −1…2,8), палец Ø2,4 вперёд в паз клина; ниже — палец захвата (раскрыт — x = 9).
      "shape": [
        { "box": [6, -48.5, -1, 14, -34.1, 2.8] },
        // Крючок: стенка за задним рельсом и губа, лежащая на рельсе сверху.
        { "box": [6, -36, -5.6, 14, -34.1, -1] },
        { "box": [6, -34.1, -5.6, 14, -29.9, -4.2] },
        { "box": [6, -31.8, -4.2, 14, -29.9, -1.2] },
        { "cylinder": { "at": [9, -42], "r": 1.2, "z": [2.8, 7], "segments": 20 } },
        { "box": [9, -62, -6, 13, -48.5, 6] }
      ],
      "color": "#FFA500",
      // Подъём клина на p сводит губку на p (паз под 45°).
      "joint": { "type": "prismatic", "parent": "slide", "origin": [0, 0, 0], "axis": [-1, 0, 0] },
      "massKg": 0.002
    },
    {
      "id": "jaw-l",
      "name": "Губка левая",
      "shape": [
        { "box": [-14, -48.5, -1, -6, -34.1, 2.8] },
        { "box": [-14, -36, -5.6, -6, -34.1, -1] },
        { "box": [-14, -34.1, -5.6, -6, -29.9, -4.2] },
        { "box": [-14, -31.8, -4.2, -6, -29.9, -1.2] },
        { "cylinder": { "at": [-9, -42], "r": 1.2, "z": [2.8, 7], "segments": 20 } },
        { "box": [-13, -62, -6, -9, -48.5, 6] }
      ],
      "color": "#FFA500",
      "joint": { "type": "prismatic", "parent": "slide", "origin": [0, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.002
    },
    {
      "id": "spring",
      "name": "Пружина штока захвата",
      // Между верхней крышкой цилиндра и поршнем (зазоры 0,2 мм): 14,6 мм — губки разведены, 10,65 мм — сведены.
      "shape": [
        { "ringX": { "x": [0, 0.8], "r": [2.2, 3] } },
        { "ringX": { "x": [2.3, 3.1], "r": [2.2, 3] } },
        { "ringX": { "x": [4.6, 5.4], "r": [2.2, 3] } },
        { "ringX": { "x": [6.9, 7.7], "r": [2.2, 3] } },
        { "ringX": { "x": [9.2, 10], "r": [2.2, 3] } },
        { "ringX": { "x": [11.5, 12.3], "r": [2.2, 3] } },
        { "ringX": { "x": [14.2, 15], "r": [2.2, 3] } }
      ],
      "color": "#C8CCD2",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "slide", "fromPoint": [0, -8.2, 5], "to": "piston", "toPoint": [0, 7.2, 5], "stretchLengthMm": 15 }
