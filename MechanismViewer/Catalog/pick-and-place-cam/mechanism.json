        { "box": [-8, -56, 38, 8, -52, 54] },
        { "box": [-5, -52, 50.5, 5, -2, 54] },
        { "cylinder": { "r": 9, "z": [50.5, 54] } },
        { "box": [89, -48, 24, 101, -34.1, 38] },
        { "box": [39, -48, 24, 51, -34.1, 38] },
