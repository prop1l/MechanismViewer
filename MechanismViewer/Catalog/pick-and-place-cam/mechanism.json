    {
      "id": "workpiece",
      "name": "Кубик 10 мм",
      // Стоит на ползуне: +12 — зажат между губками, 0 — лежит на позиции, а захват поднят.
      // Пока кубик не зажат, закон связи держит его на месте, компенсируя ход ползуна.
      "shape": [ { "box": [-5, -62, -5, 5, -52, 5] } ],
      "color": "#8FBC8F",
      "joint": { "type": "prismatic", "parent": "slide", "origin": [0, -12, 0], "axis": [0, 1, 0] },
      "massKg": 0.0012
    },
    {
      "id": "frame",
      "name": "Станина",
      // Задняя плита с окном под вал мотора, основание, позиции A и B, направляющие балки, толкателя и каретки, ось колеса.
      "shape": [
        { "box": [-55, -48, -1.8, -4, 100, -0.2] },
        { "box": [4, -48, -1.8, 140, 100, -0.2] },
        { "box": [-4, 4, -1.8, 4, 100, -0.2] },
        { "box": [-4, -48, -1.8, 4, -4, -0.2] },
