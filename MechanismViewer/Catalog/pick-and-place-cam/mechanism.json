        { "box": [-8, 60, -0.2, -3.3, 68, 49] },
        { "box": [59, -8, -0.2, 67, -4.3, 16] },  // правее крайнего положения ролика (x 57,5)
        { "cylinder": { "at": [70, 10.2], "r": 4, "z": [-0.2, 7.6] } },
        // Ось сдвоенного колеса — от задней плиты сквозь ступицу.
        { "cylinder": { "at": [70, 10.2], "r": 2, "z": [-0.2, 25], "segments": 24 } },
        { "box": [-26, 43.3, 18, 140, 46, 23.7] },
        { "box": [-26, 43.3, -0.2, -20, 46, 18] },
