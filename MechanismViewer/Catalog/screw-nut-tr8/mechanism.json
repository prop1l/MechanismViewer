{
  "id": "screw-nut-tr8",
  "name": "Ходовой винт Tr8×2 с гайкой-кареткой",
  "category": "Винтовые передачи",
  "description": "Мотор вращает трапецеидальный винт Tr8×2, гайка-каретка едет по направляющей на 50 мм и на концах хода разворачивается. Самотормозящая передача: держит нагрузку без питания.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 50, "maxForceN": 100, "maxSpeedRadS": 30 },
  "envelopeMm": [40, 54, 154],

  // 50 мм хода / 2 мм на оборот = 25 оборотов = 9000°; на упорах мотор реверсируется.
  // Муфта мотора — у самого фланца (z 0…5,5), ниже нижнего положения гайки.
  "driver": { "type": "motor", "part": "screw", "motorGapMm": 6.0, "hubSeatMm": 0.0, "range": [0, 9000], "reverseAtLimits": true },
  "output": "nut",

  "parts": [
    {
      "id": "screw",
      "name": "Винт Tr8×2",
      // Винт Tr8×2 вдоль +Z от фланца мотора; правая резьба.
      "shape": [
        { "cylinder": { "r": 2.75, "z": [0, 72] } },
        { "thread": { "r": [2.75, 4], "pitch": 2, "z": [2, 70], "width": [1.2, 0.6] } },
        { "cylinder": { "r": 2.5, "z": [72, 78] } }
      ],
      "color": "#B8BEC6",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      // Сталь, Ø8×72.
      "inertiaKgM2": 2.3e-7
    },
    {
      "id": "nut",
      "name": "Гайка-каретка",
      // Гайка-каретка: начало координат на оси винта, середина гайки.
      "shape": [
        { "box": [-11, -8, -6, 11, 8, 6] },
        { "box": [-4, 8, -6, 4, 18, 6] },
        { "cylinder": { "at": [0, 22], "r": 5.5, "z": [-6, 6] } },
        { "box": [-15, -14, -6, 15, -8, 6] }
      ],
      "color": "#FFA500",
      // Стартует у дальнего конца (z 64, торец опоры — 74); правая резьба при вращении «вперёд» тянет гайку к мотору (до z 14).
      "joint": { "type": "prismatic", "origin": [0, 0, 64], "axis": [0, 0, 1] },
      "massKg": 0.008,
      // Трение скольжения в резьбе — основная потеря винтовой пары.
      "coulombFriction": 1.5
    },
    {
      "id": "frame",
      "name": "Основание, опора и направляющая",
      "shape": [
        { "cylinder": { "at": [0, 22], "r": 3, "z": [-3.5, 76] } },  // направляющая
        { "box": [-20, -24, -3.5, 20, -21.5, 84] },  // основание — от стенки кронштейна мотора
        { "box": [-12, -21.5, 74, 12, 30, 82] },  // торцевая опора
        { "box": [-6, 16, -3.5, 6, 28, 0] }  // крепление направляющей у мотора
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "screw", "from": "screw", "to": "nut", "leadMm": -2 }
  ],

  // Винт в резьбе гайки, направляющая во втулке гайки, конец винта в торцевой опоре.
  "designedContacts": [["screw", "nut"], ["nut", "frame"], ["screw", "frame"]],

  "fasteners": [
    { "kind": "Муфта вала мотора с винтом", "size": "5×8", "attachedTo": "screw", "note": "входит в модель мотора (ступица)" },
    {
      "kind": "Винт крепления гайки к каретке",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      "positions": [[-7, -4, 6], [7, -4, 6]],
      "axis": [0, 0, -1],
      "attachedTo": "nut"
    },
    {
      "kind": "Винт крепления торцевой опоры",
      "size": "M3×12",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 12,
      "positions": [[-7, -15, 82], [7, -15, 82]],
      "axis": [0, 0, -1],
      "attachedTo": "frame"
    }
  ]
}
