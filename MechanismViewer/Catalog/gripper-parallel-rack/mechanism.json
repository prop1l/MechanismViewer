{
  "id": "gripper-parallel-rack",
  "name": "Параллельный захват робота с двумя рейками",
  "category": "Захваты и манипуляторы",
  "description": "Схват промышленного манипулятора: шестерня m1 z16 на валу мотора двигает две рейки навстречу друг другу, и губки на них сходятся параллельно, всегда симметрично относительно оси. За 142° поворота каждая губка проходит 19,8 мм и зажимает заготовку шириной 12 мм; мотор реверсирует и раскрывает захват.",

  "motion": { "input": "rotation", "output": "linear" },
  "specs": { "strokeMm": 19.8, "angleDeg": 142, "maxForceN": 2 },
  "envelopeMm": [70, 36, 40],

  // Мотор ходит между раскрытым (0°) и сжатым (142°) положениями.
  "driver": { "type": "motor", "part": "pinion", "motorGapMm": 6.0, "hubSeatMm": 6.0, "range": [0, 142], "reverseAtLimits": true },
  "output": "jaw-a",

  "parts": [
    {
      "id": "pinion",
      "name": "Шестерня",
      // m1 z16 (r = 8); зубья на 90° + 22,5°·k — сверху и снизу зуб, напротив впадин реек.
      "shape": [
        { "gear": { "module": 1, "teeth": 16, "phaseDeg": 90, "z": [0, 6] } }
      ],
      "color": "#4682B4",
      "joint": { "type": "revolute", "origin": [0, 0, 0], "axis": [0, 0, 1] },
      "gear": { "teeth": 16, "pitchRadiusMm": 8, "rootRadiusMm": 6.75, "thicknessMm": 6 },
      "inertiaKgM2": 5e-8
    },
    {
      "id": "jaw-a",
      "name": "Рейка с губкой A",
      // Рейка над шестерней, зубья вниз; делительная прямая y = 8,2 (на 0,2 мм от окружности), впадина на x = 0.
      // Губка — на правом конце, стенка выше реек и шестерни (z ≥ 6,5).
      "shape": [
        { "box": [-10, 9.45, 0, 30, 15, 6] },
        { "rack": { "origin": [1.5708, 8.2], "direction": [-1, 0], "module": 1, "teeth": [-8, 3], "z": [0, 6] } },
        { "box": [26, -15, 6.5, 30, 15, 30] },
        { "box": [26, 9.45, 6, 30, 15, 6.5] }
      ],
      "color": "#FFA500",
      // Поворот шестерни на +θ сдвигает верхнюю рейку на 8·θ мм влево (−X).
      "joint": { "type": "prismatic", "origin": [0, 0, 0], "axis": [-1, 0, 0] },
      "massKg": 0.008
    },
    {
      "id": "jaw-b",
      "name": "Рейка с губкой B",
      // Зеркально: рейка под шестерней, зубья вверх, губка на левом конце.
      "shape": [
        { "box": [-30, -15, 0, 10, -9.45, 6] },
        { "rack": { "origin": [1.5708, -8.2], "direction": [1, 0], "module": 1, "teeth": [-3, 8], "z": [0, 6] } },
        { "box": [-30, -15, 6.5, -26, 15, 30] },
        { "box": [-30, -15, 6, -26, -9.45, 6.5] }
      ],
      "color": "#FFA500",
      "joint": { "type": "prismatic", "origin": [0, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.008
    },
    {
      "id": "workpiece",
      "name": "Заготовка",
      // Деталь 12 мм в момент захвата: губки останавливаются в 0,2 мм от неё.
      "shape": [ { "box": [-6, -6, 14, 6, 6, 26] } ],
      "color": "#8FBC8F"
    },
    {
      "id": "body",
      "name": "Корпус захвата",
      // Основание с окном под вал мотора и направляющие планки реек.
      "shape": [
        { "box": [-36, -18.5, -1.8, -4, 18.5, -0.2] },
        { "box": [4, -18.5, -1.8, 36, 18.5, -0.2] },
        { "box": [-4, 4, -1.8, 4, 18.5, -0.2] },
        { "box": [-4, -18.5, -1.8, 4, -4, -0.2] },
        { "box": [-36, 15.3, -0.2, 36, 18.5, 6] },
        { "box": [-36, -18.5, -0.2, 36, -15.3, 6] }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "rack", "from": "pinion", "to": "jaw-a" },
    { "type": "rack", "from": "pinion", "to": "jaw-b" }
  ],

  "fasteners": [
    { "kind": "Стопорный винт ступицы", "size": "M3×4", "type": "set-screw", "attachedTo": "pinion", "note": "входит в модель мотора" },
    {
      "kind": "Винт крепления корпуса к фланцу робота",
      "size": "M3×8",
      "type": "socket-screw",
      "diameterMm": 3,
      "lengthMm": 8,
      "positions": [[33, 17, 6], [-33, 17, 6], [33, -17, 6], [-33, -17, 6]],
      "axis": [0, 0, -1],
      "attachedTo": "body"
    }
  ]
}
