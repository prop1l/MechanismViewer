{
  "id": "wedge-20",
  "name": "Клиновой механизм 20° с кнопкой",
  "category": "Клиновые механизмы",
  "description": "Кнопка вдвигает клин с углом 20° на 16 мм, и его наклонная грань поднимает толкатель в вертикальной направляющей на 5,8 мм. Ход уменьшается в 2,75 раза, во столько же (без учёта трения) растёт усилие. Клин возвращает пружина сжатия, толкатель опускается сам.",

  "motion": { "input": "linear", "output": "linear" },
  "specs": { "strokeMm": 5.82, "maxForceN": 10 },
  "envelopeMm": [90, 50, 13],

  // Пружина 0,15 Н/мм с поджатием 0,5 Н; палец давит на кнопку с силой 8 Н.
  "driver": {
    "type": "button",
    "part": "wedge",
    "range": [0, 16],
    "handForce": 8,
    "spring": { "stiffness": 0.15, "preload": 0.5 }
  },
  "output": "plunger",

  "parts": [
    {
      "id": "wedge",
      "name": "Клин с кнопкой",
      // Наклонная грань y = 6 − x·tg 20° на x −30…8; справа — проушина под пружину, слева — кнопка.
      "shape": [
        { "polygon": { "points": [[-34, 0], [14, 0], [14, 10], [8, 10], [8, 3.088], [-30, 16.919], [-34, 16.919]], "z": [0, 10] } },
        { "box": [-40, 3, 1, -34, 14, 9] }
      ],
      "color": "#D9534F",
      // Нажатие — вправо (+X).
      "joint": { "type": "prismatic", "origin": [0, 0, 0], "axis": [1, 0, 0] },
      "massKg": 0.0055
    },
    {
      "id": "plunger",
      "name": "Толкатель",
      // Начало координат — над осью направляющей на высоте грани клина; скошенный торец параллелен грани (зазор 0,15 мм).
      "shape": [
        { "polygon": { "points": [[-5, 1.97], [5, -1.67], [5, 34], [7, 34], [7, 40], [-7, 40], [-7, 34], [-5, 34]], "z": [1, 9] } }
      ],
      "color": "#FFA500",
      "joint": { "type": "prismatic", "origin": [0, 6, 0], "axis": [0, 1, 0] },
      "massKg": 0.0035
    },
    {
      "id": "spring",
      "name": "Пружина сжатия",
      // Пружина вдоль +X длиной 26 мм (растягивается между точками крепления: 26 → 10 мм).
      "shape": [
        { "ringX": { "x": [0, 0.8], "r": [1.5, 3.5] } },
        { "ringX": { "x": [3.15, 4.05], "r": [2.4, 3.4] } },
        { "ringX": { "x": [6.3, 7.2], "r": [2.4, 3.4] } },
        { "ringX": { "x": [9.45, 10.35], "r": [2.4, 3.4] } },
        { "ringX": { "x": [12.6, 13.5], "r": [2.4, 3.4] } },
        { "ringX": { "x": [15.75, 16.65], "r": [2.4, 3.4] } },
        { "ringX": { "x": [18.9, 19.8], "r": [2.4, 3.4] } },
        { "ringX": { "x": [22.05, 22.95], "r": [2.4, 3.4] } },
        { "ringX": { "x": [25.2, 26], "r": [1.5, 3.5] } }
      ],
      "color": "#C8CCD2",
      "joint": {
        "type": "link",
        "axis": [0, 0, 1],
        "link": { "from": "housing", "fromPoint": [40, 5, 5], "to": "wedge", "toPoint": [14, 5, 5], "stretchLengthMm": 26 }
      }
    },
    {
      "id": "housing",
      "name": "Корпус",
      // Основание под клином, задняя стенка, стенки направляющей толкателя (выше клина) и упор пружины.
      "shape": [
        { "box": [-46, -4, -3, 46, -0.15, 10] },
        { "box": [-46, -4, -3, 46, 40, -0.2] },
        { "box": [-9, 16, -0.2, -5.3, 39.5, 10] },
        { "box": [5.3, 16, -0.2, 9, 39.5, 10] },
        { "box": [40.2, -4, -3, 44, 12, 10] }
      ],
      "color": "#5A606A"
    }
  ],

  "couplings": [
    { "type": "wedge", "from": "wedge", "to": "plunger", "angleDeg": 20 }
  ],

  "fasteners": [
    { "kind": "Пружина сжатия", "size": "Ø7×26, 0,15 Н/мм", "type": "spring", "attachedTo": "spring", "note": "показана как деталь «Пружина сжатия»" },
    {
      "kind": "Саморез крепления корпуса",
      "size": "2,2×6",
      "type": "self-tapping",
      "diameterMm": 2.2,
      "lengthMm": 6,
      // В заднюю стенку, вне хода клина и толкателя.
      "positions": [[-40, 34, -0.2], [30, 34, -0.2]],
      "axis": [0, 0, -1],
      "attachedTo": "housing"
    }
  ]
}
